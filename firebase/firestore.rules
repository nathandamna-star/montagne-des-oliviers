rules_version = '2';

// Règles de sécurité (modèle : docs/modele-donnees.md ; CLAUDE.md, sections 4 à 7).
// Tout ce qui n'est pas explicitement autorisé est refusé.
service cloud.firestore {
  match /databases/{database}/documents {

    // ----- Outils -----

    function connecte() {
      return request.auth != null;
    }

    function moi() {
      return request.auth.uid;
    }

    // Membre de l'église : compte connecté ayant donné son consentement (profil créé).
    function estMembre() {
      return connecte() && exists(/databases/$(database)/documents/users/$(moi()));
    }

    // Rôles : custom claims attribués par une Cloud Function, jamais par l'app.
    function estAdmin() {
      return connecte() && request.auth.token.admin == true;
    }

    function estSecretariat() {
      return connecte() && (request.auth.token.secretariat == true || estAdmin());
    }

    function estTresorier() {
      return connecte() && (request.auth.token.tresorier == true || estAdmin());
    }

    function texte(v, max) {
      return v is string && v.size() > 0 && v.size() <= max;
    }

    function texteFacultatif(v, max) {
      return v == null || (v is string && v.size() <= max);
    }

    function lien(v) {
      return v == null || v == '' || (v is string && v.matches('https://.+') && v.size() <= 1000);
    }

    // Texte traduit : { fr, nl? } ; le français est obligatoire.
    function traduit(v, max) {
      return v is map && v.keys().hasOnly(['fr', 'nl'])
        && texte(v.fr, max) && texteFacultatif(v.get('nl', null), max);
    }

    function nouveau() {
      return request.resource.data;
    }

    function ancien() {
      return resource.data;
    }

    function seulement(champs) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(champs);
    }

    function visible(d) {
      return d.publie == true && (d.visibilite == 'public' || estMembre());
    }

    // Communication structurée belge : 12 chiffres, contrôle modulo 97.
    function communicationValide(c) {
      return c.matches('[1-9][0-9]{11}')
        && (int(c[0:10]) % 97 == 0 ? 97 : int(c[0:10]) % 97) == int(c[10:12]);
    }

    // ----- Profils des comptes -----
    match /users/{uid} {
      // Chacun le sien ; le secrétariat et l'administrateur voient les comptes.
      allow read: if (connecte() && uid == moi()) || estSecretariat();

      // Création : consentement explicite daté par le serveur.
      allow create: if connecte() && uid == moi()
        && nouveau().keys().hasOnly(['nom', 'email', 'langue', 'consentementLe', 'createdAt'])
        && texte(nouveau().nom, 100)
        && nouveau().email is string
        && nouveau().langue in ['fr', 'nl']
        && nouveau().consentementLe == request.time;

      // Modification par soi-même : jamais les rôles ni le consentement.
      allow update: if connecte() && uid == moi()
        && seulement(['nom', 'langue', 'photoUrl', 'jetonsNotif', 'decalageMin'])
        && texte(nouveau().nom, 100)
        && nouveau().langue in ['fr', 'nl']
        && nouveau().get('jetonsNotif', []) is list
        && nouveau().get('jetonsNotif', []).size() <= 20
        && lien(nouveau().get('photoUrl', null));

      allow delete: if connecte() && uid == moi();
    }

    // ----- Annuaire : nom des comptes (pour composer les groupes), tenu par le serveur -----
    match /annuaire/{uid} {
      allow read: if estMembre();
    }

    // ----- Fichier des membres (données sensibles : secrétariat et pasteurs) -----
    match /membres/{id} {
      allow read: if estSecretariat()
        || (connecte() && resource.data.get('uid', null) == moi());
      allow create, update: if estSecretariat()
        && texte(nouveau().nom, 100)
        && nouveau().statut in ['visiteur', 'membre', 'actif'];
      allow delete: if estSecretariat();
    }

    match /familles/{id} {
      allow read, delete: if estSecretariat();
      allow create, update: if estSecretariat() && texte(nouveau().nom, 100);
    }

    // ----- Paramètres de l'église (IBAN, horaires, chaîne YouTube…) : lisibles par tous -----
    match /parametres/eglise {
      allow read: if true;
      allow write: if estAdmin() || estTresorier();
    }

    // ----- Actualités -----
    match /actualites/{id} {
      allow read: if visible(resource.data) || estSecretariat();
      allow create, update: if estSecretariat()
        && traduit(nouveau().titre, 200)
        && traduit(nouveau().texte, 20000)
        && nouveau().visibilite in ['public', 'membres']
        && nouveau().publie is bool
        && nouveau().epingle is bool
        && lien(nouveau().get('photoUrl', null));
      allow delete: if estSecretariat();
    }

    // ----- Calendrier : cultes et événements -----
    match /evenements/{id} {
      allow read: if visible(resource.data) || estSecretariat();
      allow create, update: if estSecretariat()
        && traduit(nouveau().titre, 200)
        && nouveau().type in ['culte', 'priere', 'jeune', 'cellule', 'evenement', 'conference']
        && nouveau().debut is timestamp
        && nouveau().fin is timestamp
        && nouveau().fin >= nouveau().debut
        && nouveau().visibilite in ['public', 'membres']
        && nouveau().publie is bool
        && nouveau().inscription is bool;
      allow delete: if estSecretariat();

      // Inscriptions : chacun la sienne (le nombre d'inscrits est tenu par le serveur).
      match /inscriptions/{uid} {
        function evenement() {
          return get(/databases/$(database)/documents/evenements/$(id)).data;
        }
        allow read: if (connecte() && uid == moi()) || estSecretariat();
        allow create, update: if estMembre() && uid == moi()
          && evenement().publie == true && evenement().inscription == true
          && nouveau().keys().hasOnly(['nom', 'personnes', 'createdAt'])
          && texte(nouveau().nom, 100)
          && nouveau().personnes is int
          && nouveau().personnes >= 1 && nouveau().personnes <= 10;
        allow delete: if (connecte() && uid == moi()) || estSecretariat();
      }
    }

    // ----- Demandes : baptême, présentation d'enfant, mariage, rendez-vous, visite -----
    match /demandes/{id} {
      allow read: if estSecretariat() || (connecte() && resource.data.uid == moi());
      allow create: if estMembre()
        && nouveau().keys().hasOnly(['uid', 'nom', 'type', 'message', 'statut', 'createdAt'])
        && nouveau().uid == moi()
        && texte(nouveau().nom, 100)
        && nouveau().type in ['bapteme', 'presentation', 'mariage', 'rendezvous', 'visite']
        && texteFacultatif(nouveau().message, 5000)
        && nouveau().statut == 'nouvelle'
        && nouveau().createdAt == request.time;
      // Le secrétariat et les pasteurs répondent et font avancer la demande.
      allow update: if estSecretariat()
        && seulement(['statut', 'reponse', 'traiteePar', 'updatedAt'])
        && nouveau().statut in ['nouvelle', 'en_cours', 'acceptee', 'refusee', 'terminee'];
      // La personne peut retirer une demande pas encore traitée.
      allow delete: if estSecretariat()
        || (connecte() && resource.data.uid == moi() && resource.data.statut == 'nouvelle');
    }

    // ----- Groupes (cellules, intercession, louange, modération…) -----
    function groupe(gid) {
      return get(/databases/$(database)/documents/groupes/$(gid)).data;
    }

    function membreGroupe(gid) {
      return connecte() && moi() in groupe(gid).membres;
    }

    function adminGroupe(gid) {
      return connecte() && moi() in groupe(gid).admins;
    }

    function groupeValide(d) {
      return texte(d.nom, 100)
        && texteFacultatif(d.get('description', null), 2000)
        && d.type in ['cellule', 'intercession', 'jeunes', 'femmes', 'hommes', 'louange',
                      'moderation', 'media', 'cuisine', 'entraide', 'autre']
        && d.prive is bool
        && d.membres is list && d.membres.size() <= 500
        && d.admins is list && d.admins.size() >= 1
        && d.membres.hasAll(d.admins)
        && lien(d.get('lienAppel', null));
    }

    match /groupes/{gid} {
      // Groupe ouvert : visible des membres de l'église ; groupe privé : de ses membres.
      allow read: if estSecretariat()
        || (connecte() && moi() in resource.data.membres)
        || (resource.data.prive == false && estMembre());
      // Création et suppression : pasteur ou secrétariat (qui nomment les administrateurs).
      allow create: if estSecretariat() && groupeValide(nouveau());
      allow delete: if estSecretariat();
      allow update: if groupeValide(nouveau()) && (
        estSecretariat()
        // L'administrateur du groupe gère membres, administrateurs, texte et lien d'appel.
        || (connecte() && moi() in ancien().admins
            && seulement(['nom', 'description', 'membres', 'admins', 'lienAppel', 'photoUrl',
                          'horaires', 'updatedAt']))
        // Un membre peut quitter le groupe (sauf s'il en est administrateur).
        || (connecte() && moi() in ancien().membres && !(moi() in ancien().admins)
            && seulement(['membres'])
            && nouveau().membres.toSet() == ancien().membres.toSet().difference([moi()].toSet()))
      );

      // Messagerie privée du groupe.
      match /messages/{mid} {
        allow read: if membreGroupe(gid);
        allow create: if membreGroupe(gid)
          && nouveau().keys().hasOnly(['auteur', 'nom', 'texte', 'fichierUrl', 'createdAt'])
          && nouveau().auteur == moi()
          && texte(nouveau().nom, 100)
          && texteFacultatif(nouveau().texte, 5000)
          && lien(nouveau().get('fichierUrl', null))
          && nouveau().createdAt == request.time;
        allow delete: if (membreGroupe(gid) && resource.data.auteur == moi()) || adminGroupe(gid);
      }

      // Calendrier du groupe : réunions, répétitions (louange), modérations, appels programmés.
      match /rencontres/{rid} {
        allow read: if membreGroupe(gid) || estSecretariat();
        allow create, update: if (adminGroupe(gid) || estSecretariat())
          && nouveau().type in ['reunion', 'repetition', 'moderation', 'appel']
          && texte(nouveau().titre, 200)
          && nouveau().debut is timestamp
          && nouveau().get('modeAppel', 'aucun') in ['aucun', 'app', 'externe'];
        // Modération : le modérateur prévu demande un remplacement ; un autre membre du
        // groupe peut alors prendre sa place.
        allow update: if membreGroupe(gid) && seulement(['moderateur', 'remplacement'])
          && ((resource.data.get('moderateur', null) == moi()
                && nouveau().moderateur == moi()
                && nouveau().remplacement in ['aucun', 'demande'])
            || (resource.data.get('remplacement', 'aucun') == 'demande'
                && nouveau().moderateur == moi()
                && nouveau().remplacement == 'aucun'));
        allow delete: if adminGroupe(gid) || estSecretariat();

        // Présence : « Je viens / Je ne viens pas / Peut-être » (ou disponible pour une modération).
        match /presences/{uid} {
          allow read: if membreGroupe(gid);
          allow write: if membreGroupe(gid) && uid == moi()
            && request.resource.data.keys().hasOnly(['reponse', 'nom', 'updatedAt'])
            && request.resource.data.reponse in ['oui', 'non', 'peutetre'];
          allow delete: if membreGroupe(gid) && uid == moi();
        }
      }

      // Appel en cours (appel dans l'app ou lien externe).
      match /appels/{aid} {
        allow read: if membreGroupe(gid);
        allow write: if adminGroupe(gid)
          && request.resource.data.mode in ['app', 'externe']
          && request.resource.data.enCours is bool;
        allow delete: if adminGroupe(gid);
      }
    }

    // ----- Sujets de prière -----
    // « pasteurs » : lu par l'auteur et les pasteurs ; « intercession » : aussi par les membres
    // du groupe d'intercession choisi.
    match /prieres/{pid} {
      function lisible(d) {
        return estAdmin()
          || (connecte() && d.uid == moi())
          || (d.partage == 'intercession' && membreGroupe(d.groupeId));
      }

      allow read: if lisible(resource.data);
      allow create: if estMembre()
        && nouveau().keys().hasOnly(['uid', 'nom', 'anonyme', 'texte', 'partage', 'groupeId',
                                     'statut', 'createdAt'])
        && nouveau().uid == moi()
        && texte(nouveau().nom, 100)
        && nouveau().anonyme is bool
        && texte(nouveau().texte, 5000)
        && ((nouveau().partage == 'pasteurs' && nouveau().groupeId == null)
          || (nouveau().partage == 'intercession'
              && groupe(nouveau().groupeId).type == 'intercession'))
        && nouveau().statut == 'ouverte'
        && nouveau().createdAt == request.time;
      // L'auteur annonce l'exaucement et écrit son témoignage.
      allow update: if connecte() && resource.data.uid == moi()
        && seulement(['statut', 'temoignage', 'updatedAt'])
        && nouveau().statut in ['ouverte', 'exaucee']
        && texteFacultatif(nouveau().get('temoignage', null), 5000);
      allow delete: if estAdmin() || (connecte() && resource.data.uid == moi());

      // « J'ai prié » : une marque par personne (le total est tenu par le serveur).
      match /priants/{uid} {
        allow read: if lisible(get(/databases/$(database)/documents/prieres/$(pid)).data);
        allow create: if connecte() && uid == moi()
          && lisible(get(/databases/$(database)/documents/prieres/$(pid)).data)
          && request.resource.data.keys().hasOnly(['le'])
          && request.resource.data.le == request.time;
        allow delete: if connecte() && uid == moi();
      }
    }

    // ----- Divers : anniversaires, naissances, fêtes (annoncés par les membres) -----
    function responsableCuisine() {
      let p = get(/databases/$(database)/documents/parametres/eglise).data;
      return connecte() && p.get('groupeCuisineId', null) != null
        && moi() in get(/databases/$(database)/documents/groupes/$(p.groupeCuisineId)).data.membres;
    }

    function feteValide(d) {
      return texte(d.titre, 200)
        && d.type in ['anniversaire', 'naissance', 'mariage', 'fete', 'autre']
        && d.date is timestamp
        && texteFacultatif(d.get('lieu', null), 200)
        && texteFacultatif(d.get('description', null), 2000);
    }

    match /fetes/{fid} {
      allow read: if estMembre();
      allow create: if estMembre()
        && nouveau().keys().hasOnly(['titre', 'type', 'date', 'lieu', 'description', 'uid', 'nom',
                                     'createdAt'])
        && nouveau().uid == moi()
        && texte(nouveau().nom, 100)
        && feteValide(nouveau())
        && nouveau().createdAt == request.time;
      allow update: if (estSecretariat() || (connecte() && ancien().uid == moi()))
        && seulement(['titre', 'type', 'date', 'lieu', 'description'])
        && feteValide(nouveau());
      allow delete: if estSecretariat() || (connecte() && ancien().uid == moi());

      // Ce que chacun apporte : pour informer les responsables cuisine.
      match /apports/{uid} {
        allow read: if (connecte() && uid == moi()) || estSecretariat() || responsableCuisine();
        allow write: if estMembre() && uid == moi()
          && request.resource.data.keys().hasOnly(['nom', 'apporte', 'precision', 'updatedAt'])
          && texte(request.resource.data.nom, 100)
          && request.resource.data.apporte is list
          && request.resource.data.apporte.size() >= 1
          && request.resource.data.apporte.hasOnly(['nourriture', 'gateau', 'boisson', 'autre'])
          && texteFacultatif(request.resource.data.get('precision', null), 300);
        allow delete: if connecte() && uid == moi();
      }
    }

    // ----- Préparations au mariage et au baptême -----
    match /preparations/{prid} {
      function inscrit() {
        return connecte()
          && exists(/databases/$(database)/documents/preparations/$(prid)/inscrits/$(moi()));
      }

      allow read: if estAdmin() || inscrit() || resource.data.publie == true;
      allow create, update: if estAdmin()
        && nouveau().type in ['mariage', 'bapteme']
        && traduit(nouveau().titre, 200)
        && nouveau().publie is bool;
      allow delete: if estAdmin();

      // Leçons : texte, audio, vidéo, document, questions. Réservées aux inscrits,
      // sauf celles rendues publiques.
      match /lecons/{lid} {
        allow read: if estAdmin() || inscrit() || resource.data.get('publique', false) == true;
        allow create, update: if estAdmin()
          && traduit(nouveau().titre, 200)
          && nouveau().ordre is int
          && nouveau().publique is bool
          && lien(nouveau().get('audioUrl', null))
          && lien(nouveau().get('videoUrl', null))
          && lien(nouveau().get('documentUrl', null));
        allow delete: if estAdmin();
      }

      // Candidats inscrits par le pasteur (après leur demande) ; chacun coche ses leçons.
      match /inscrits/{uid} {
        allow read: if estAdmin() || (connecte() && uid == moi());
        allow create, delete: if estAdmin();
        allow update: if estAdmin()
          || (connecte() && uid == moi() && seulement(['faites', 'updatedAt'])
              && nouveau().faites is list);

        // Questions au pasteur.
        match /questions/{qid} {
          allow read: if estAdmin() || (connecte() && uid == moi());
          allow create: if connecte() && uid == moi()
            && request.resource.data.keys().hasOnly(['texte', 'leconId', 'createdAt'])
            && texte(request.resource.data.texte, 5000)
            && request.resource.data.createdAt == request.time;
          allow update: if estAdmin()
            && request.resource.data.diff(resource.data).affectedKeys()
                 .hasOnly(['reponse', 'reponduLe']);
          allow delete: if estAdmin();
        }
      }
    }

    // ----- Planning des services (équipes : sono, accueil, école du dimanche…) -----
    function equipeValide(d) {
      return texte(d.nom, 100)
        && texteFacultatif(d.get('description', null), 500)
        && d.membres is list && d.membres.size() <= 300
        && d.responsables is list
        && d.membres.hasAll(d.responsables);
    }

    match /equipes/{eid} {
      function equipe() {
        return get(/databases/$(database)/documents/equipes/$(eid)).data;
      }

      function responsableEquipe() {
        return connecte() && moi() in equipe().responsables;
      }

      allow read: if estMembre();
      allow create: if estSecretariat() && equipeValide(nouveau());
      // Les responsables de l'équipe gèrent ses membres (pas les responsables).
      allow update: if equipeValide(nouveau())
        && (estSecretariat() || (responsableEquipe() && seulement(['membres', 'updatedAt'])));
      allow delete: if estSecretariat();

      // Affectations : qui sert à quel culte ; la personne confirme ou demande un
      // remplacement ; un autre membre de l'équipe peut alors reprendre.
      match /affectations/{aid} {
        function affectationValide(d) {
          return d.uid is string && texte(d.nom, 100)
            && d.date is timestamp
            && texte(d.titre, 200)
            && texteFacultatif(d.get('role', null), 100)
            && d.statut in ['prevu', 'confirme', 'indisponible', 'remplacement'];
        }

        allow read: if estSecretariat() || (connecte() && moi() in equipe().membres);
        allow create: if (estSecretariat() || responsableEquipe())
          && affectationValide(nouveau())
          && nouveau().uid in equipe().membres;
        allow delete: if estSecretariat() || responsableEquipe();
        allow update: if ((estSecretariat() || responsableEquipe()) && affectationValide(nouveau()))
          || (connecte() && ancien().uid == moi()
              && seulement(['statut'])
              && nouveau().statut in ['confirme', 'indisponible', 'remplacement'])
          || (connecte() && moi() in equipe().membres && ancien().uid != moi()
              && ancien().statut in ['indisponible', 'remplacement']
              && seulement(['uid', 'nom', 'statut', 'remplace'])
              && nouveau().uid == moi()
              && texte(nouveau().nom, 100)
              && nouveau().statut == 'confirme');
      }
    }

    // Mon planning : mes affectations dans toutes les équipes.
    match /{chemin=**}/affectations/{aid} {
      allow read: if connecte() && resource.data.uid == moi();
    }

    // ----- Entretien de la salle : séances de nettoyage, inscription libre -----
    match /nettoyages/{nid} {
      allow read: if estMembre();
      allow create, update: if estSecretariat()
        && texte(nouveau().titre, 200)
        && nouveau().date is timestamp
        && texteFacultatif(nouveau().get('description', null), 1000)
        && (nouveau().get('places', null) == null
          || (nouveau().places is int && nouveau().places >= 1 && nouveau().places <= 100));
      allow delete: if estSecretariat();

      // Chacun s'inscrit (ou se désinscrit) lui-même ; le nombre est tenu par le serveur.
      match /inscrits/{uid} {
        allow read: if estMembre();
        allow create: if estMembre() && uid == moi()
          && request.resource.data.keys().hasOnly(['nom', 'createdAt'])
          && texte(request.resource.data.nom, 100)
          && request.resource.data.createdAt == request.time;
        allow delete: if (connecte() && uid == moi()) || estSecretariat();
      }
    }

    // ----- Salles et réservations -----
    match /salles/{sid} {
      allow read: if estMembre();
      allow create, update: if estSecretariat()
        && texte(nouveau().nom, 100)
        && (nouveau().get('capacite', null) == null || nouveau().capacite is int)
        && texteFacultatif(nouveau().get('description', null), 1000);
      allow delete: if estSecretariat();
    }

    match /reservations/{id} {
      // Les réservations validées sont visibles (pour voir les créneaux occupés).
      allow read: if estSecretariat()
        || (connecte() && resource.data.uid == moi())
        || (estMembre() && resource.data.statut == 'validee');
      allow create: if estMembre()
        && nouveau().keys().hasOnly(['uid', 'nom', 'salleId', 'salleNom', 'debut', 'fin', 'motif',
                                     'statut', 'createdAt'])
        && nouveau().uid == moi()
        && texte(nouveau().nom, 100)
        && texte(nouveau().motif, 500)
        && nouveau().debut is timestamp
        && nouveau().fin > nouveau().debut
        && nouveau().statut == 'demandee'
        && nouveau().createdAt == request.time;
      allow update: if (estSecretariat()
          && seulement(['statut', 'reponse', 'updatedAt'])
          && nouveau().statut in ['demandee', 'validee', 'refusee', 'annulee'])
        || (connecte() && resource.data.uid == moi()
          && seulement(['statut', 'updatedAt']) && nouveau().statut == 'annulee');
      allow delete: if estSecretariat();
    }

    // ----- Médias : prédications, exhortations, direct ; verset du jour -----
    match /medias/{id} {
      allow read: if visible(resource.data) || estSecretariat();
      allow create, update: if estSecretariat()
        && nouveau().type in ['audio', 'video', 'direct']
        && nouveau().get('rubrique', 'predication') in ['predication', 'enseignement', 'podcast']
        && (nouveau().get('theme', null) == null || nouveau().theme in ['repentance', 'delivrance',
            'guerison', 'combatSpirituel', 'liensFamille', 'foi', 'priere', 'mariage', 'bapteme', 'autre'])
        && traduit(nouveau().titre, 200)
        && nouveau().visibilite in ['public', 'membres']
        && nouveau().publie is bool
        && lien(nouveau().get('url', null));
      allow delete: if estSecretariat();
    }

    match /versets/{id} {
      allow read: if true;
      allow create, update: if estSecretariat()
        && texte(nouveau().reference, 100)
        && traduit(nouveau().texte, 2000)
        && nouveau().ordre is int;
      allow delete: if estSecretariat();
    }

    // ----- Dîmes et offrandes -----
    // L'identifiant d'un don par virement est sa communication structurée.
    // Les dons par carte (Stripe) sont écrits par le serveur seulement.
    match /dons/{id} {
      allow read: if estTresorier() || (connecte() && resource.data.uid == moi());
      allow create: if estMembre()
        && communicationValide(id)
        && nouveau().keys().hasOnly(['uid', 'nom', 'montant', 'devise', 'affectation', 'mode',
                                     'statut', 'createdAt'])
        && nouveau().uid == moi()
        && texte(nouveau().nom, 100)
        && nouveau().montant is number
        && nouveau().montant > 0 && nouveau().montant <= 100000
        && nouveau().devise == 'EUR'
        && nouveau().affectation in ['dime', 'offrande', 'mission', 'construction', 'loyer', 'entraide']
        && nouveau().mode == 'virement'
        && nouveau().statut == 'en_attente'
        && nouveau().createdAt == request.time;
      // Le trésorier confirme la réception (ou annule) ; le donateur peut renoncer.
      allow update: if (estTresorier()
          && seulement(['statut', 'confirmeLe', 'confirmePar'])
          && nouveau().statut in ['recu', 'annule'])
        || (connecte() && resource.data.uid == moi() && resource.data.statut == 'en_attente'
          && seulement(['statut']) && nouveau().statut == 'annule');
    }

    // ----- Prise de contact (visiteurs compris) : lue par les pasteurs seulement -----
    match /contacts/{id} {
      allow create: if nouveau().keys().hasOnly(['nom', 'email', 'telephone', 'sujet', 'message',
                                                 'consentement', 'uid', 'traite', 'createdAt'])
        && texte(nouveau().nom, 100)
        && texteFacultatif(nouveau().get('email', null), 200)
        && texteFacultatif(nouveau().get('telephone', null), 40)
        && (nouveau().get('email', '') != '' || nouveau().get('telephone', '') != '')
        && nouveau().sujet in ['priere', 'delivrance', 'guerison', 'accompagnement', 'question', 'autre']
        && texte(nouveau().message, 3000)
        && nouveau().consentement == true
        && nouveau().traite == false
        && (nouveau().get('uid', null) == null || (connecte() && nouveau().uid == moi()))
        && nouveau().createdAt == request.time;
      allow read, delete: if estAdmin();
      allow update: if estAdmin() && seulement(['traite', 'traitePar', 'traiteLe']);
    }

    // Dons mensuels (abonnements Stripe) : écrits par le serveur seulement.
    match /donsMensuels/{id} {
      allow read: if estTresorier() || (connecte() && resource.data.uid == moi());
    }

    // ----- Boutique de livres -----
    function gereBoutique() {
      return estTresorier() || estSecretariat();
    }

    match /livres/{id} {
      allow read: if true;
      allow create, update: if gereBoutique()
        && nouveau().keys().hasOnly(['titre', 'auteur', 'description', 'prix', 'photoUrl',
                                     'disponible', 'updatedAt'])
        && texte(nouveau().titre, 200)
        && texteFacultatif(nouveau().get('auteur', null), 100)
        && (nouveau().get('description', null) == null || traduit(nouveau().description, 3000))
        && nouveau().prix is number && nouveau().prix >= 1 && nouveau().prix <= 1000
        && nouveau().disponible is bool
        && lien(nouveau().get('photoUrl', null));
      allow delete: if gereBoutique();
    }

    // Commandes : créées par le serveur (prix relus dans le catalogue).
    match /commandes/{id} {
      allow read: if gereBoutique() || (connecte() && resource.data.uid == moi());
      allow update: if (gereBoutique()
          && seulement(['statut', 'majLe', 'majPar'])
          && nouveau().statut in ['en_attente', 'payee', 'remise', 'annulee']
          && nouveau().majPar == moi())
        || (connecte() && resource.data.uid == moi()
          && resource.data.mode == 'virement' && resource.data.statut == 'en_attente'
          && seulement(['statut']) && nouveau().statut == 'annulee');
    }

    // `systeme/*` : réservé aux Cloud Functions (aucun accès depuis l'app).
  }
}
