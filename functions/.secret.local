# Valeurs factices pour l'émulateur (tests). Les vraies clés sont des secrets
# Firebase, saisies dans le Terminal :
#   npx firebase-tools functions:secrets:set STRIPE_SECRET_KEY
#   npx firebase-tools functions:secrets:set STRIPE_WEBHOOK_SECRET
STRIPE_SECRET_KEY=sk_test_factice
STRIPE_WEBHOOK_SECRET=whsec_emulateur
